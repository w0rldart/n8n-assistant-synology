# Copy to .env and fill in. Never commit .env; .gitignore already excludes it.
#
# Generate each secret separately, with something like:
#   openssl rand -hex 32

# --- Versions -----------------------------------------------------------
# Pin both. A :stable tag means an upgrade arrives during a restart you made
# for something else. The api, runner and sandbox images ship as one release,
# so a single sandbox version covers all three.
# https://github.com/n8n-io/n8n/releases
# https://github.com/n8n-io/n8n-sandbox-service/releases
N8N_VERSION=2.38.1
N8N_SANDBOX_VERSION=1.4.0

# --- Host -----------------------------------------------------------------
# The address n8n binds to. Use the NAS's LAN address rather than 0.0.0.0 if
# you do not want it on every interface.
N8N_BIND_IP=192.168.1.10
N8N_HOST=192.168.1.10
GENERIC_TIMEZONE=Europe/Zurich

# --- Database -------------------------------------------------------------
# An existing Postgres reachable on the `svc` network. Not created by this
# compose file.
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=

# --- n8n ------------------------------------------------------------------
# Losing this key means losing every stored credential. Back it up somewhere
# other than the NAS.
N8N_ENCRYPTION_KEY=
N8N_RUNNERS_AUTH_TOKEN=

# --- Assistant ------------------------------------------------------------
# Leave the model key empty and the Assistant stays off. The sandbox stack
# still starts, idle.
N8N_INSTANCE_AI_MODEL_API_KEY=

# --- Sandbox service ------------------------------------------------------
# Three separate secrets, each used by a different pair of containers:
#   SANDBOX_API_KEY            n8n    -> sandbox-api
#   SANDBOX_REGISTRATION_TOKEN runner -> sandbox-api, to register
#   SANDBOX_RUNNER_API_KEY     api    -> runner, per request
# Do not reuse one value for all three.
SANDBOX_API_KEY=
SANDBOX_REGISTRATION_TOKEN=
SANDBOX_RUNNER_API_KEY=
